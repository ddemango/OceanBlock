{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "node": "22.12.0",
      "ios": {
        "image": "latest",
        "scheme": "App",
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "simulator": {
      "node": "22.12.0",
      "ios": {
        "simulator": true,
        "image": "latest",
        "scheme": "App",
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
